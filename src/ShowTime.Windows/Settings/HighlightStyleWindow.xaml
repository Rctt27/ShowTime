<Window x:Class="ShowTime.HighlightStyleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShowTime — Trait du surlignage" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#F5F5F5" FontSize="13">
    <Window.Resources>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="16" Width="660">
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,8"
                   Text="Maintenez le bouton gauche dans la zone et tracez : c'est le trait de l'enregistrement, sur un fond clair et sur un fond sombre."/>

        <!-- The trail is drawn by the recording's own overlay, placed over this zone at each press. -->
        <Border x:Name="Zone" DockPanel.Dock="Top" Height="240" Cursor="Cross" BorderBrush="#CCC" BorderThickness="1"
                MouseLeftButtonDown="Zone_MouseLeftButtonDown" MouseLeftButtonUp="Zone_MouseLeftButtonUp">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Border Background="#FFFFFF" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Nouvelle page de paiement" FontSize="18" FontWeight="SemiBold" Foreground="#1C2230"/>
                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#5D6676"
                                   Text="Le parcours passe de cinq écrans à deux. Le récapitulatif de commande reste visible pendant la saisie de la carte."/>
                        <Border Margin="0,16,0,0" HorizontalAlignment="Left" Background="#2F6FDE" CornerRadius="6" Padding="14,6">
                            <TextBlock Text="Publier la page" Foreground="White" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="#1D2028" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Tableau de bord" FontSize="18" FontWeight="SemiBold" Foreground="#E6E9EF"/>
                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#98A1B0"
                                   Text="Le temps moyen passe à 48 secondes, et le taux d'abandon au paiement baisse de 31 %."/>
                        <Border Margin="0,16,0,0" HorizontalAlignment="Left" Background="#6B9BFF" CornerRadius="6" Padding="14,6">
                            <TextBlock Text="Prévisualiser" Foreground="#0E1320" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button DockPanel.Dock="Left" Content="Valeurs par défaut" Padding="10,3" Click="Defaults_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Annuler" Width="100" Padding="0,5" Margin="0,0,8,0" IsCancel="True"/>
                <Button Content="OK" Width="100" Padding="0,5" IsDefault="True" Click="Ok_Click"/>
            </StackPanel>
        </DockPanel>

        <UniformGrid x:Name="SliderPanel" Columns="3" Margin="0,8,0,0"/>
    </DockPanel>
</Window>
